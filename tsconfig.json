{
  // Sources and tests. Node.js runs the .ts files directly by removing the types, so only syntax that can be
  // erased is allowed (no enum, no namespace). `npm run build` compiles src/ to dist/ with tsconfig.build.json.
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "test", "scripts", "action/*.ts"],
  // Code samples that VS Code colors (scripts/vscode-inspect.ts), not code of the package
  "exclude": ["test/data/inspect"]
}
